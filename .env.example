# Copy to .env and fill in what you use. With nothing set, the desk runs in demo mode on mock data.

# Admin login (leave blank only for local testing: the password gate turns off when unset)
JSENT_PASSWORD=
JSENT_SECRET=

# Data
APIFY_TOKEN=
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional Instagram session scraper
IG_USERNAME=
IG_PASSWORD=
IG_COOKIE=

# Briefs, trend reads and deal scoring (Claude)
ANTHROPIC_API_KEY=
JSENT_BRIEF_MODEL=

# Brand-deal inbox
DEAL_DOMAIN=
DEAL_DOMAINS=
DEAL_IMAP_HOST=
DEAL_IMAP_USER=
DEAL_IMAP_PASSWORD=
DEAL_SMTP_HOST=
DEAL_SMTP_PORT=
DEAL_SMTP_USER=
DEAL_SMTP_PASSWORD=
DEAL_FROM=

PORT=8782
